# Base path/URL for the Centum SMS API.
#
# In development, leave this unset: vite.config.ts proxies /api-backend to
# http://localhost:8080, which works around the backend having no CORS
# middleware configured today.
#
# In production, point this at the API's own origin. Note the backend still
# has no CORS middleware - either add one there, or serve this app from the
# same origin/reverse proxy as the API.
# VITE_API_BASE_URL=https://api.example.com
